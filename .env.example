# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# ---------------------------------------------------------------------------
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---------------------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------------------
# Secret used to sign the stateless JWT session cookie. Use a long random string.
SESSION_SECRET="change-me-to-a-long-random-string"
# Secret used to sign CSRF tokens. Use a different long random string.
CSRF_SECRET="change-me-to-another-long-random-string"

# ---------------------------------------------------------------------------
# Bootstrap admin (used by the seed script to create the first admin user)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
