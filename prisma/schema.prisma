// Prisma schema — Weekly Football
//
// Domain model for a weekly 5-a-side competition. Design goals:
//  - Players are a global pool; each match selects its own participants.
//  - Teams are per-match (never permanent).
//  - Per-player, per-match stats live on MatchParticipant (counters).
//  - MatchEvent is a lightweight append-only history behind the counters,
//    enabling corrections/auditing without the live UI depending on it.
//  - Career stats + rankings are computed by aggregation (no denormalized
//    totals in the MVP), so they can never drift out of sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (runtime, serverless-friendly)
  directUrl = env("DIRECT_URL") // direct (Prisma Migrate)
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Kept extensible for future roles (e.g. SCOREKEEPER) without a migration
/// churn on existing rows.
enum Role {
  ADMIN
}

enum MatchStatus {
  DRAFT
  LIVE
  FINISHED
  CANCELLED
}

enum MatchEventType {
  GOAL
  ASSIST
  SAVE
  OWN_GOAL
  CORRECTION
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Authenticated admin users. Passwords are always stored hashed.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdMatches Match[]      @relation("MatchCreatedBy")
  recordedEvents MatchEvent[] @relation("EventCreatedBy")

  @@map("users")
}

/// A football player. Part of a global pool, not tied to any single match.
/// Never hard-deleted once they have history — deactivated via isActive.
model Player {
  id        String   @id @default(cuid())
  name      String
  nickname  String?
  avatarUrl String?
  isActive  Boolean  @default(true)
  /// Fantasy price in millions LE. Admin-set; used for the fantasy budget cap.
  price     Int      @default(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participations MatchParticipant[]
  achievements   PlayerAchievement[]

  @@index([isActive])
  @@map("players")
}

/// One football session. Owns its teams, participants and event history.
model Match {
  id          String      @id @default(cuid())
  title       String?
  matchDate   DateTime
  status      MatchStatus @default(DRAFT)
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  startedAt   DateTime?
  finishedAt  DateTime?

  createdBy      User               @relation("MatchCreatedBy", fields: [createdById], references: [id])
  teams          MatchTeam[]
  participants   MatchParticipant[]
  events         MatchEvent[]
  fantasyEntries FantasyEntry[]

  @@index([status])
  @@index([matchDate])
  @@index([createdById])
  @@map("matches")
}

/// A team that exists only within a single match (e.g. "Team A" / "Team B").
model MatchTeam {
  id        String @id @default(cuid())
  matchId   String
  name      String
  shortName String

  match        Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participants MatchParticipant[]

  // Prevents duplicate team names within the same match.
  @@unique([matchId, name])
  @@index([matchId])
  @@map("match_teams")
}

/// A player's participation in a specific match, carrying the live counters.
/// The assigned team must belong to the same match — enforced in the service
/// layer (a DB constraint cannot express the cross-column relationship).
model MatchParticipant {
  id        String   @id @default(cuid())
  matchId   String
  playerId  String
  teamId    String
  goals     Int      @default(0)
  assists   Int      @default(0)
  saves     Int      @default(0)
  ownGoals  Int      @default(0)
  /// Set when the match is finished; supports joint Man of the Match on ties.
  isMotm    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match        Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player       Player        @relation(fields: [playerId], references: [id])
  team         MatchTeam     @relation(fields: [teamId], references: [id])
  events       MatchEvent[]
  fantasyPicks FantasyPick[]

  // A player cannot participate twice in the same match.
  @@unique([matchId, playerId])
  @@index([playerId])
  @@index([teamId])
  @@index([matchId])
  @@map("match_participants")
}

/// Append-only history behind the counters. Every increment/decrement writes a
/// row; corrections are recorded as new rows rather than destroying history.
model MatchEvent {
  id                 String         @id @default(cuid())
  matchId            String
  matchParticipantId String
  type               MatchEventType
  /// +1 for an increment, -1 for a decrement/correction.
  value              Int
  createdAt          DateTime       @default(now())
  createdById        String?

  match       Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participant MatchParticipant @relation(fields: [matchParticipantId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation("EventCreatedBy", fields: [createdById], references: [id])

  @@index([matchId])
  @@index([matchParticipantId])
  @@map("match_events")
}

/// Catalog of available achievements. Definitions are also mirrored in the
/// AchievementService config (the source of truth for unlock rules); this table
/// stores the canonical English label + icon and is seeded from that config.
/// Display strings are translated in views via i18n keys `achievement.<code>.*`.
model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  icon        String
  createdAt   DateTime @default(now())

  players PlayerAchievement[]

  @@map("achievements")
}

/// Junction: an achievement a player has unlocked (once). Optionally records
/// the match in which it was unlocked, for the match-result "newly unlocked"
/// list and profile context.
model PlayerAchievement {
  id            String   @id @default(cuid())
  playerId      String
  achievementId String
  matchId       String?
  unlockedAt    DateTime @default(now())

  player      Player      @relation(fields: [playerId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  // An achievement unlocks at most once per player.
  @@unique([playerId, achievementId])
  @@index([playerId])
  @@index([achievementId])
  @@map("player_achievements")
}

// ---------------------------------------------------------------------------
// Fantasy game
// ---------------------------------------------------------------------------

/// A registered fantasy player (distinct from admin Users and from football
/// Players). Self-registers with email + password.
model FantasyUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries           FantasyEntry[]
  ownedLeagues      FantasyLeague[]       @relation("LeagueOwner")
  leagueMemberships FantasyLeagueMember[]

  @@map("fantasy_users")
}

/// A private mini-league. Members join with the shareable `code`; standings
/// rank members by their total fantasy points.
model FantasyLeague {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  ownerId   String
  createdAt DateTime @default(now())

  owner   FantasyUser           @relation("LeagueOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members FantasyLeagueMember[]

  @@index([ownerId])
  @@map("fantasy_leagues")
}

/// Membership of a fantasy user in a league (the creator is a member too).
model FantasyLeagueMember {
  id       String   @id @default(cuid())
  leagueId String
  userId   String
  joinedAt DateTime @default(now())

  league FantasyLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   FantasyUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([userId])
  @@index([leagueId])
  @@map("fantasy_league_members")
}

/// A user's fantasy plan for a single match: 5 picks + a captain, scored once
/// the match is finished. One plan per user per match.
model FantasyEntry {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  /// Final fantasy points, set when the match is finished (null until then).
  points    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  FantasyUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  picks FantasyPick[]

  @@unique([userId, matchId])
  @@index([matchId])
  @@index([userId])
  @@map("fantasy_entries")
}

/// One of the 5 players in a fantasy entry, referencing the player's
/// participation in that match. Exactly one pick per entry is the captain.
model FantasyPick {
  id                 String  @id @default(cuid())
  entryId            String
  matchParticipantId String
  isCaptain          Boolean @default(false)

  entry       FantasyEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  participant MatchParticipant @relation(fields: [matchParticipantId], references: [id], onDelete: Cascade)

  @@unique([entryId, matchParticipantId])
  @@index([entryId])
  @@index([matchParticipantId])
  @@map("fantasy_picks")
}
