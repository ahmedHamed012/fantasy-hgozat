extends layouts/base

block content
  section.hero
    img.hero__crest(src="/static/imgs/logo.png", alt=t('app.name'), width="140", height="140")
    h1.hero__title= t('home.hero.title')
    p.hero__subtitle= t('home.hero.subtitle')
    .hero__actions
      a.btn.btn--primary(href="/fantasy")= t('home.cta.play')
      a.btn.btn--ghost(href="/leaderboard")= t('home.cta.leaderboard')

  section.feature-grid
    .feature-card
      .feature-card__icon
        +icon('bolt')
      h3.feature-card__title= t('home.feature.fast.title')
      p.feature-card__text= t('home.feature.fast.text')
    .feature-card
      .feature-card__icon
        +icon('trophy')
      h3.feature-card__title= t('home.feature.points.title')
      p.feature-card__text= t('home.feature.points.text')
    .feature-card
      .feature-card__icon
        +icon('medal')
      h3.feature-card__title= t('home.feature.badges.title')
      p.feature-card__text= t('home.feature.badges.text')
