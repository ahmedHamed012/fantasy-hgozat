extends ../layouts/base

block content
  .page-head
    h1.page-head__title= t('admin.dashboard.heading')
    form(method="post", action="/auth/logout")
      input(type="hidden", name="_csrf", value=csrfToken)
      button.btn.btn--ghost.btn--sm(type="submit")= t('nav.logout')
  .card
    p= t('admin.dashboard.welcome', { email: currentUser.email })
    p.muted= t('admin.dashboard.placeholder')
    .dashboard-links
      a.btn.btn--primary(href="/admin/matches/new")= t('admin.nav.newMatch')
      a.btn.btn--ghost(href="/admin/matches")= t('admin.nav.matches')
      a.btn.btn--ghost(href="/admin/players")= t('admin.nav.players')
