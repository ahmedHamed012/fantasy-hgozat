extends ../layouts/base

block content
  .auth-wrap
    .card.auth-card
      h1.auth-card__title= t('user.login.heading')
      p.muted= t('user.login.subtitle')
      if error
        .alert.alert--error= error
      form.auth-form(method="post", action="/login")
        input(type="hidden", name="_csrf", value=csrfToken)
        if next
          input(type="hidden", name="next", value=next)
        .form-group
          label.form-label(for="email")= t('user.field.email')
          input.form-input#email(type="email", name="email", required, autocomplete="username", autofocus)
        .form-group
          label.form-label(for="password")= t('user.field.password')
          input.form-input#password(type="password", name="password", required, autocomplete="current-password")
        button.btn.btn--primary.btn--block(type="submit")= t('user.login.submit')
      p.auth-alt.muted
        = t('user.login.noAccount') + ' '
        a.link(href="/register")= t('user.login.register')
