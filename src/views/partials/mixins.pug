//- Reusable Pug mixins. res.locals (t, csrfToken, ...) are in scope wherever
//- these are called.

//- Hidden CSRF field for any POST form.
mixin csrf
  input(type="hidden", name="_csrf", value=csrfToken)

//- Inline SVG icon referencing the sprite in partials/icons.pug.
mixin icon(name, cls)
  svg.icon(class=cls, aria-hidden="true", focusable="false")
    use(href=`#i-${name}`)

//- Coloured status badge for a match status (DRAFT/LIVE/FINISHED/CANCELLED).
mixin statusBadge(status)
  span.status-badge(class=`status-badge--${status.toLowerCase()}`)= t('match.status.' + status)

//- Stat tile for profile/dashboard summaries. `iconName` references the sprite.
mixin statTile(label, value, iconName, highlight)
  .stat-tile(class=(highlight ? 'stat-tile--primary' : ''))
    .stat-tile__icon
      +icon(iconName)
    .stat-tile__value= value
    .stat-tile__label= label

//- Achievement badge card. `a` = { icon (sprite name), name, description }.
mixin achievementBadge(a)
  .badge-card(title=a.description)
    .badge-card__icon
      +icon(a.icon)
    .badge-card__name= a.name

//- A single kit on the fantasy pitch. teamShort 'A'/'B' picks the colour.
mixin pitchKit(name, teamShort, isCaptain, sub)
  .pitch-kit(class=`pitch-kit--${(teamShort || 'a').toLowerCase()}`)
    .pitch-kit__shirt
      +icon('kit')
      if isCaptain
        span.pitch-kit__cap= t('fantasy.plan.captainShort')
    span.pitch-kit__name= name
    if sub
      span.pitch-kit__sub= sub

//- Player avatar: image when avatarUrl is set, otherwise an initials circle.
mixin avatar(player, size)
  - var s = size || 'md'
  if player.avatarUrl
    img.avatar(class=`avatar--${s}`, src=player.avatarUrl, alt=player.name, loading="lazy")
  else
    - var initial = (player.name || '?').trim().charAt(0).toUpperCase()
    span.avatar.avatar--initials(class=`avatar--${s}`, aria-hidden="true")= initial
